# Justfile for rockilus backend
# Usage: cd backend && just <recipe>

root_dir := `cd .. && pwd`

all:
    echo "Running all checks in shared, api_gateway, and solve_service..."
    cd shared just all
    cd api_gateway just all
    cd solve_service just all

all-no-test:
    echo "Running format, lint, typecheck across services (no tests)..."
    cd shared && just all-no-test
    cd api_gateway && just all-no-test
    cd solve_service && just all-no-test

security:
    @echo "--- shared ---"
    @cd shared && just security
    @echo "--- api_gateway ---"
    @cd api_gateway && just security
    @echo "--- solve_service ---"
    @cd solve_service && just security

# Run all cross-cutting security scans (ZAP, Trivy, Gitleaks, Hadolint, ShellCheck).
security-all: security-trivy security-gitleaks security-hadolint security-shellcheck security-zap

# Run OWASP ZAP DAST against the API Gateway.
# Requires Docker. Spins up an ephemeral stack, seeds a test user,
# runs an active API scan, and tears down. Results in ../security-reports/
security-zap:
    @docker-compose -f ../docker-compose.zap.yml down -v 2>/dev/null || true
    @echo "=== Starting ZAP ephemeral stack (MongoDB, LocalStack, Cerbos, FastAPI) ==="
    @docker-compose -f ../docker-compose.zap.yml up -d --wait
    @echo "=== Seeding test user for authenticated ZAP requests ==="
    @bash ../scripts/seed-zap-user.sh
    @echo "=== Running ZAP API active scan (this takes 2-5 minutes) ==="
    @mkdir -p ../security-reports
    @docker run --rm --network zap-network -v "{{root_dir}}:/zap/wrk:rw" -t ghcr.io/zaproxy/zaproxy:stable zap-api-scan.py -t http://fastapi:4000/openapi.json -f openapi -r /zap/wrk/security-reports/zap-api-report.html -z "-configfile /zap/wrk/.zap/options.prop" || true
    @echo "=== Tearing down ZAP stack ==="
    @docker-compose -f ../docker-compose.zap.yml down -v
    @echo "=== Report: security-reports/zap-api-report.html ==="

# Scan full commit history for exposed secrets using the repo's .gitleaks.toml rules.
security-gitleaks:
    @echo "=== Gitleaks: Scanning Git History for Exposed Secrets ==="
    @mkdir -p ../security-reports
    @docker run --rm \
        -v "{{root_dir}}:/path" \
        zricethezav/gitleaks:latest detect \
        --source=/path \
        --verbose \
        --report-path /path/security-reports/gitleaks-report.json || true
    @echo "=== Report: security-reports/gitleaks-report.json ==="

# Scan staged changes only (fast pre-commit check).
security-gitleaks-staged:
    @echo "=== Gitleaks: Scanning Staged Changes ==="
    @docker run --rm \
        -v "{{root_dir}}:/path" \
        zricethezav/gitleaks:latest protect \
        --source=/path \
        --staged \
        --verbose || true

# Run all Trivy scans (config + fs + image).
security-trivy: security-trivy-config security-trivy-fs security-trivy-image
    @echo "=== All Trivy scans complete ==="

# Scan IaC configurations (Dockerfiles, docker-compose.yml, Terraform) across the repo.
# Advisory: reports findings but never fails.
security-trivy-config:
    @echo "=== Trivy: Scanning IaC configurations ==="
    @mkdir -p ../security-reports
    @docker run --rm \
        -v trivy-cache:/root/.cache/trivy \
        -v "{{root_dir}}:/apps" \
        aquasec/trivy:latest config \
        --severity HIGH,CRITICAL \
        --exit-code 1 \
        --format json \
        --output /apps/security-reports/trivy-config.json \
        /apps || true
    @echo "=== Report: security-reports/trivy-config.json ==="

# Scan filesystem for dependency CVEs (Python + npm) across the repo.
# Advisory: reports findings but never fails (pip-audit + npm audit already gate).
security-trivy-fs:
    @echo "=== Trivy: Scanning filesystem dependencies (advisory) ==="
    @mkdir -p ../security-reports
    @docker run --rm \
        -v trivy-cache:/root/.cache/trivy \
        -v "{{root_dir}}:/apps" \
        aquasec/trivy:latest fs \
        --severity HIGH,CRITICAL \
        --format json \
        --output /apps/security-reports/trivy-fs.json \
        --skip-dirs node_modules,__pycache__,.next,out,.venv \
        /apps || true
    @echo "=== Report: security-reports/trivy-fs.json ==="

# Build and scan container images for OS-level CVEs.
# Scans api_gateway, solve_service, and cerbos. Cleans up tags after.
security-trivy-image:
    @echo "=== Building images for Trivy scan ==="
    @docker build -t rockilus-api-gateway:trivy-scan -f api_gateway/Dockerfile .
    @docker build -t rockilus-solve-service:trivy-scan -f solve_service/Dockerfile .
    @docker build -t rockilus-cerbos:trivy-scan -f ../cerbos-policies/Dockerfile ../cerbos-policies
    @echo "=== Trivy: Scanning api_gateway image ==="
    @mkdir -p ../security-reports
    @docker run --rm \
        -v trivy-cache:/root/.cache/trivy \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "{{root_dir}}/security-reports:/reports" \
        aquasec/trivy:latest image \
        --severity HIGH,CRITICAL \
        --exit-code 1 \
        --format json \
        --output /reports/trivy-image-api-gateway.json \
        rockilus-api-gateway:trivy-scan || true
    @echo "=== Trivy: Scanning solve_service image ==="
    @docker run --rm \
        -v trivy-cache:/root/.cache/trivy \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "{{root_dir}}/security-reports:/reports" \
        aquasec/trivy:latest image \
        --severity HIGH,CRITICAL \
        --exit-code 1 \
        --format json \
        --output /reports/trivy-image-solve-service.json \
        rockilus-solve-service:trivy-scan || true
    @echo "=== Trivy: Scanning cerbos image ==="
    @docker run --rm \
        -v trivy-cache:/root/.cache/trivy \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "{{root_dir}}/security-reports:/reports" \
        aquasec/trivy:latest image \
        --severity HIGH,CRITICAL \
        --exit-code 1 \
        --format json \
        --output /reports/trivy-image-cerbos.json \
        rockilus-cerbos:trivy-scan || true
    @echo "=== Cleaning up scan images ==="
    @docker rmi rockilus-api-gateway:trivy-scan rockilus-solve-service:trivy-scan rockilus-cerbos:trivy-scan 2>/dev/null || true
    @echo "=== Reports: security-reports/trivy-image-*.json ==="

# Lint all production and utility Dockerfiles with Hadolint.
# Advisory: reports findings but never fails.
# Mirrors CI coverage plus the init-user utility Dockerfile.
security-hadolint:
    @echo "=== Hadolint: Linting api_gateway/Dockerfile ==="
    @docker run --rm -i hadolint/hadolint < api_gateway/Dockerfile || true
    @echo "=== Hadolint: Linting solve_service/Dockerfile ==="
    @docker run --rm -i hadolint/hadolint < solve_service/Dockerfile || true
    @echo "=== Hadolint: Linting cerbos-policies/Dockerfile ==="
    @docker run --rm -i hadolint/hadolint < ../cerbos-policies/Dockerfile || true
    @echo "=== Hadolint: Linting frontend/Dockerfile ==="
    @docker run --rm -i hadolint/hadolint < ../frontend/Dockerfile || true
    @echo "=== Hadolint: Linting scripts/Dockerfile.init-user ==="
    @docker run --rm -i hadolint/hadolint < ../scripts/Dockerfile.init-user || true

# Lint all shell scripts in the repo with ShellCheck.
# Uses -S error to only report error-level violations.
# Advisory: reports findings but never fails.
security-shellcheck:
    @echo "=== ShellCheck: Linting all shell scripts ==="
    @find "{{root_dir}}" -name '*.sh' -exec docker run --rm -v "{}:/script:ro" koalaman/shellcheck:stable -S error /script \; || true


