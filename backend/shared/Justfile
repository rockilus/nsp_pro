# Justfile for rockilus backend shared library (service-local tasks)

format:
    echo "Formatting shared..."
    uv run ruff format .
    uv run ruff check --fix .

lint:
    echo "Running linter for shared..."
    uv run ruff check .

typecheck:
    echo "Running type checker for shared..."
    uv run python -m mypy .

test:
    echo "Running tests for shared..."
    uv run pytest

all:
    just format
    just lint
    just typecheck
    just test
    just security

all-no-test:
    just format
    just lint
    just typecheck

security:
    just audit-deps
    just bandit
    just semgrep

audit-deps:
    echo "Running pip-audit for shared..."
    uv run pip-audit

bandit:
    echo "Running bandit for shared..."
    uv run bandit -r src/ -ll

semgrep:
    echo "Running semgrep for shared..."
    uv run semgrep --config=auto --error src/