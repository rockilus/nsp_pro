# Justfile for rockilus backend shared library (service-local tasks)

format:
    echo "Formatting shared..."
    uv run ruff format .
    uv run ruff check --fix .

lint:
    echo "Running linter for shared..."
    uv run ruff check .

typecheck:
    echo "Running type checker for shared..."
    uv run python -m mypy .

test:
    echo "Running tests for shared..."
    uv run pytest

all:
    just format
    just lint
    just typecheck
    just test
    just security

all-no-test:
    just format
    just lint
    just typecheck

security:
    @just audit-deps
    @just bandit
    @just semgrep

audit-deps:
    @echo "  pip-audit:" 
    @uv run pip-audit > /tmp/pa.log 2>&1; RC=${?}; sed '/^Name.*Skip/,$d' /tmp/pa.log; rm -f /tmp/pa.log; exit ${RC}

bandit:
    @echo "  bandit:"
    @uv run bandit -r src/ -ll

semgrep:
    @echo "  semgrep:"
    @uv run semgrep --config=auto --error --quiet src/