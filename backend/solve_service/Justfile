# Justfile for backend solve_service

update-shared:
    echo "Reinstall shared package..."
    uv sync --reinstall-package shared

format:
    echo "Formatting solve_service..."
    uv run ruff format .
    uv run ruff check --fix .

lint:
    echo "Running linter for solve_service..."
    uv run ruff check .

typecheck:
    echo "Running type checker for solve_service..."
    uv run python -m mypy .

test:
    echo "Running tests for solve_service..."
    uv run pytest

all:
    just update-shared
    just format
    just lint
    just typecheck
    just test
    just security

all-no-test:
    just update-shared
    just format
    just lint
    just typecheck

security:
    @just audit-deps
    @just bandit
    @just semgrep

audit-deps:
    @echo "  pip-audit:" 
    @uv run pip-audit > /tmp/pa.log 2>&1; RC=${?}; sed '/^Name.*Skip/,$d' /tmp/pa.log; rm -f /tmp/pa.log; exit ${RC}

bandit:
    @echo "  bandit:"
    @uv run bandit -r src/ -ll

semgrep:
    @echo "  semgrep:"
    @uv run semgrep --config=auto --error --quiet src/

dev:
    echo "Starting solve_service (SQS consumer)..."
    uv run python -m src.main --env-file .env.development.tests
