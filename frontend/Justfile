set shell := ['bash', '-lc']

format:
	echo "Running Prettier..."
	npx prettier --write .

lint:
	echo "Running ESLint..."
	npx eslint src && npx eslint tests

typecheck:
	echo "Running TypeScript check..."
	npx tsc --noEmit

test:
	echo "Running Vitest..."
	npx vitest run && npx jest

all: format lint typecheck test
all-no-test: format lint typecheck

dev:
	echo "Starting Next.js dev server on port 3000..."
	npx next dev --turbopack --port 3000
