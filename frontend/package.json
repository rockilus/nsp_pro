{
  "name": "nsp_pro_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dev": "dotenv -e .env.development -- next build",
    "build:staging": "dotenv -e .env.staging -- next build",
    "build:prod": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "deploy:s3:prod": "aws s3 sync out/ s3://rockilus-frontend-prod --delete --profile rockilus-production",
    "deploy:s3:staging": "aws s3 sync out/ s3://rockilus-frontend-staging --delete --profile rockilus-staging",
    "deploy": "npm run build:static && npm run deploy:s3",
    "serve": "npx serve out -l 3000"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@mui/x-date-pickers": "^8.17.0",
    "@tanstack/react-query": "^5.90.8",
    "@types/react-color": "^3.0.13",
    "@types/react-window": "^2.0.0",
    "accept-language": "^3.0.20",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "next": "16.0.1",
    "nextjs-cors": "^2.2.1",
    "oidc-client-ts": "^3.4.0",
    "react": "19.2.0",
    "react-cookie": "^8.0.1",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^16.3.1",
    "react-oidc-context": "^3.3.0",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3"
  }
}
