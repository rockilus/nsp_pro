set shell := ['bash', '-lc']

format:
	echo "Running Prettier..."
	npx prettier --write .

lint:
	echo "Running ESLint..."
	npx eslint .

typecheck:
	echo "Running TypeScript check..."
	npx tsc --noEmit

test:
	echo "Running Vitest..."
	npx vitest run

audit-deps:
	echo "Running npm audit for rockilus-web..."
	npm audit --audit-level=high

security:
	echo "Running security checks for rockilus-web..."
	just audit-deps

all: format lint typecheck security

dev:
	echo "Starting Next.js dev server on port 3001..."
	npx next dev --turbopack --port 3001
